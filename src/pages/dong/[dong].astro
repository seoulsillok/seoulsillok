---
import Layout from '../../layouts/Layout.astro';
import { ALL_DONGS, SOCIAL_LINKS, findDongBySlug, getDistrictByCode, getDongSlug, getLocalizedDistrictName, getLocalizedDongName } from '../../data/seoul';
import { INSTAGRAM_POSTS_BY_DONG, INSTAGRAM_PROFILE_URL } from '../../data/instagram-posts.generated';

export async function getStaticPaths() {
  const aliases = ['jongno-9', 'jongno-10', 'jongno-11', 'jongno-12', 'jung-9', 'jung-10', 'jung-11', 'jung-12'];
  return [...ALL_DONGS.map((entry) => ({ params: { dong: entry.slug } })), ...aliases.map((dong) => ({ params: { dong } }))];
}

const slug = String(Astro.params.dong || '');
const record = findDongBySlug(slug);
const district = record ? getDistrictByCode(record.districtCode) : undefined;
const districtNameEn = record ? getLocalizedDistrictName({ code: record.districtCode, nameKo: record.districtKo }, 'en') : '';
const dongNameEn = record ? getLocalizedDongName(record.nameKo, 'en') : '';

const instagramPosts = record ? INSTAGRAM_POSTS_BY_DONG[`${record.districtCode}:${record.nameKo}`] || [] : [];
---

<Layout title={record ? `${record.nameKo} 기록` : '동네 기록'} description="서울 동네 기록 상세 페이지">
  {record ? (
    <article class="detail">
      <p class="eyebrow">INSTAGRAM ARCHIVE</p>
      <h1>
        <span data-copy-locale="ko">{record.nameKo}</span>
        <span data-copy-locale="en">{dongNameEn}</span>
      </h1>
      <p class="meta">
        <span data-copy-locale="ko">{record.districtKo}</span>
        <span data-copy-locale="en">{districtNameEn}</span>
      </p>

      {instagramPosts.length ? (
        <div class="post-list">
          {instagramPosts.map((instagramPost) => (
            <section class="post-card" aria-label="인스타그램 포스트">
              <header>
                <small>Instagram Post</small>
                <h2>{instagramPost.title}</h2>
              </header>
              {instagramPost.video ? (
                <div class="video-frame">
                  <video controls playsinline preload="metadata" poster={instagramPost.video.poster} aria-label={`${instagramPost.title} 영상`}>
                    <source src={instagramPost.video.src} type="video/mp4" />
                    <a href={instagramPost.url} target="_blank" rel="noopener noreferrer">Instagram에서 영상 보기</a>
                  </video>
                </div>
              ) : (
                <div class="embed">
                  <blockquote class="instagram-media" data-instgrm-permalink={instagramPost.url} data-instgrm-version="14" style="width:100%;max-width:none;margin:0"></blockquote>
                </div>
              )}
              {instagramPost.caption ? (
                <section class="post-caption" aria-label="Instagram caption">
                  <h3><span data-copy-locale="ko">인스타그램 글</span><span data-copy-locale="en">Instagram caption</span></h3>
                  <p>{instagramPost.caption}</p>
                </section>
              ) : null}
              <a href={instagramPost.url} target="_blank" rel="noopener noreferrer">
                <span data-copy-locale="ko">해당 포스트 보러 가기</span>
                <span data-copy-locale="en">View this post</span>
              </a>
            </section>
          ))}
          {instagramPosts.some((post) => !post.video) ? <script async src="https://www.instagram.com/embed.js"></script> : null}
        </div>
      ) : (
        <section class="post-card" aria-label="인스타그램 포스트 없음">
          <header>
            <small>Instagram Post</small>
            <h2 data-copy-locale="ko">등록 대기 중</h2>
            <h2 data-copy-locale="en">Pending</h2>
          </header>
          <p class="note" data-copy-locale="ko">
            이 동네에 연결된 Instagram 포스트가 아직 없습니다.
          </p>
          <p class="note" data-copy-locale="en">
            No Instagram post is linked to this dong yet.
          </p>
          <a href={INSTAGRAM_PROFILE_URL} target="_blank" rel="noreferrer">
            <span data-copy-locale="ko">@seoulsillok 프로필 열기</span>
            <span data-copy-locale="en">Open @seoulsillok profile</span>
          </a>
        </section>
      )}

      <section class="actions">
        <a href={`/#district-${record.districtCode}`}>
          <span data-copy-locale="ko">← {record.districtKo} 목록으로</span>
          <span data-copy-locale="en">← Back to {districtNameEn}</span>
        </a>
        <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noreferrer">
          <span data-copy-locale="ko">서울실록 인스타그램</span>
          <span data-copy-locale="en">Seoul Sillok Instagram</span>
        </a>
      </section>

      {district ? (
        <section class="related">
          <h2 data-copy-locale="ko">{record.districtKo}의 다른 동네</h2>
          <h2 data-copy-locale="en">Other neighborhoods in {districtNameEn}</h2>
          <ul>
            {district.dongs.map((dong, index) => (
              <li>
                <a href={`/dong/${getDongSlug(district.code, dong, index)}`} class:list={[{ active: dong === record.nameKo }]}>
                  <span data-copy-locale="ko">{dong}</span>
                  <span data-copy-locale="en">{getLocalizedDongName(dong, 'en')}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : null}
    </article>
  ) : (
    <article class="detail">
      <h1 data-copy-locale="ko">존재하지 않는 동네 페이지입니다.</h1>
      <h1 data-copy-locale="en">This neighborhood page does not exist.</h1>
      <p class="note" data-copy-locale="ko">요청한 경로를 찾을 수 없습니다. 홈의 동네 목록으로 이동해 주세요.</p>
      <p class="note" data-copy-locale="en">The requested path could not be found. Please go back to the directory on the homepage.</p>
      <section class="actions">
        <a href="/">
          <span data-copy-locale="ko">홈으로 이동</span>
          <span data-copy-locale="en">Go to homepage</span>
        </a>
      </section>
    </article>
  )}
</Layout>

<style>
  .detail {
    max-width: 860px;
    margin: 0 auto;
    border: 1px solid #e4dfd4;
    border-radius: 16px;
    padding: 1.05rem;
    background: #fffdf9;
  }

  .eyebrow {
    margin: 0;
    color: #6b645a;
    letter-spacing: 0.11em;
    font-size: 0.71rem;
    font-weight: 700;
  }

  h1 {
    margin: 0.5rem 0 0;
    font-family: 'Fraunces', serif;
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    color: #1e1b17;
  }

  .meta {
    color: #555045;
    margin: 0.2rem 0 0.9rem;
    font-size: 0.9rem;
  }

  .post-card {
    border: 1px solid #e7e1d6;
    border-radius: 12px;
    padding: 0.9rem;
    background: #fff;
  }

  .post-list {
    display: grid;
    gap: 0.8rem;
  }

  .post-card header small {
    color: #6b645a;
  }

  .post-card h2 {
    margin: 0.25rem 0 0;
    font-size: 1.1rem;
    color: #201d18;
  }

  .embed {
    margin-top: 0.8rem;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid #ebe4d8;
    background: #fff;
  }

  .video-frame {
    margin-top: 0.8rem;
    overflow: hidden;
    border-radius: 10px;
    background: #111;
  }

  .video-frame video {
    display: block;
    width: 100%;
    max-height: 75vh;
    background: #111;
  }

  .embed :global(iframe.instagram-media) {
    display: block;
    width: 100% !important;
    max-width: none !important;
    min-width: 0 !important;
    margin: 0 !important;
    box-sizing: border-box;
  }

  .post-caption {
    margin: 0.85rem 0;
    padding: 1rem;
    border-radius: 9px;
    background: #f7f3ec;
  }

  .post-caption h3 {
    margin: 0 0 0.7rem;
    color: #6b645a;
    font-size: 0.78rem;
    letter-spacing: 0.03em;
  }

  .post-caption p {
    margin: 0;
    white-space: pre-wrap;
    font-family: 'Noto Sans KR', sans-serif;
    color: #2c281f;
    line-height: 1.66;
    font-size: 0.9rem;
  }

  .note {
    margin: 0.85rem 0;
    color: #585145;
    line-height: 1.65;
    font-size: 0.9rem;
  }

  .post-card > a,
  .actions a {
    display: inline-block;
    text-decoration: none;
    color: #1d1b16;
    border-radius: 999px;
    border: 1px solid #d6cfbf;
    background: #fff;
    padding: 0.42rem 0.72rem;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .post-card > a:hover,
  .actions a:hover {
    border-color: #1f1d19;
    background: #1f1d19;
    color: #fff;
  }

  .actions {
    margin-top: 0.9rem;
    display: flex;
    gap: 0.56rem;
    flex-wrap: wrap;
  }

  .related {
    margin-top: 1.05rem;
    border-top: 1px solid #ece7dc;
    padding-top: 0.85rem;
  }

  .related h2 {
    margin: 0;
    color: #24201a;
    font-size: 1rem;
  }

  .related ul {
    margin: 0.65rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
  }

  .related a {
    text-decoration: none;
    color: #5d564a;
    border: 1px solid #e7e1d6;
    border-radius: 999px;
    padding: 0.25rem 0.56rem;
    font-size: 0.78rem;
  }

  .related a.active {
    color: #fff;
    background: #1f1d19;
    border-color: #1f1d19;
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .detail {
      padding: 0;
      border: 0;
      background: transparent;
    }

    .post-card {
      padding: 0.5rem;
    }
  }
</style>
