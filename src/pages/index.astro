---
import Layout from '../layouts/Layout.astro';
import NeighborhoodDirectory from '../components/NeighborhoodDirectory.astro';
import { SOCIAL_LINKS } from '../data/seoul';
---

<Layout title="서울 실록" description="서울 전체 동네를 감각적으로 기록하는 아카이브">
  <section class="hero">
    <p class="eyebrow">Seoul Sillok</p>
    <h1 data-copy-locale="ko">서울을 기록합니다</h1>
    <h1 data-copy-locale="en">Documenting Seoul.</h1>
    <p class="lead" data-copy-locale="ko">
      Instagram 포스트를 기반으로 동네 페이지와 연결합니다.
      구를 선택하고, 연결된 동네 포스트를 바로 확인하세요.
    </p>
    <p class="lead" data-copy-locale="en">
      Connected to Instagram posts.
      Select a district and jump directly to the linked neighborhood pages.
    </p>
    <div class="hero-cta">
      <a href="#home-directory" class="btn dark">
        <span data-copy-locale="ko">지도에서 탐색하기</span>
        <span data-copy-locale="en">Explore on this page</span>
      </a>
      <a href={SOCIAL_LINKS.instagram} class="btn light" target="_blank" rel="noreferrer">@seoulsillok</a>
    </div>
  </section>

  <section class="map-block" id="home-directory">
    <header>
      <h2 data-copy-locale="ko">서울 동네 탐색</h2>
      <h2 data-copy-locale="en">Explore Seoul Neighborhoods</h2>
      <p data-copy-locale="ko">지도에서 구를 선택하면 같은 페이지 안에서 해당 구만 확대되고, 아래 목록도 함께 필터링됩니다.</p>
      <p data-copy-locale="en">Select a district on the map to zoom in and filter the directory below without leaving the homepage.</p>
    </header>
    <NeighborhoodDirectory />
  </section>
</Layout>

<style>
  .hero {
    padding: 1.5rem 0 1.1rem;
  }

  .eyebrow {
    margin: 0;
    color: #746d61;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    font-weight: 700;
  }

  h1 {
    margin: 0.62rem 0 0;
    font-family: 'Fraunces', serif;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.06;
    color: #201d18;
  }

  .lead {
    margin: 1rem 0 0;
    max-width: 690px;
    color: #544c42;
    line-height: 1.72;
  }

  .hero-cta {
    margin-top: 1.2rem;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .btn {
    text-decoration: none;
    border-radius: 999px;
    padding: 0.62rem 0.95rem;
    font-size: 0.86rem;
    font-weight: 700;
    border: 1px solid #1f1d19;
  }

  .btn.dark {
    color: #fcfbf8;
    background: #1f1d19;
  }

  .btn.light {
    color: #1f1d19;
    background: #fcfbf8;
  }

  .map-block {
    margin-top: 1rem;
  }

  .map-block h2 {
    margin: 0;
    font-family: 'Fraunces', serif;
    color: #201d18;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .map-block p {
    margin: 0.45rem 0 0.8rem;
    color: #60584d;
  }
</style>
