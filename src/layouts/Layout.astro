---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Seoul Sillok',
  description = '서울의 동네를 감각적으로 기록하는 아카이브 플랫폼'
} = Astro.props;
---

<!doctype html>
<html lang="ko" data-site-locale="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | 서울 실록</title>
    <script is:inline>
      (() => {
        const storageKey = 'seoul-sillok-locale';
        let locale = 'ko';

        try {
          locale = localStorage.getItem(storageKey) === 'en' ? 'en' : 'ko';
        } catch {}

        document.documentElement.dataset.siteLocale = locale;
        document.documentElement.lang = locale;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a href="/" class="logo">
          <span class="logo-mark">SS</span>
          <span>Seoul Sillok</span>
        </a>
        <div class="header-actions">
          <nav>
            <a href="/">
              <span data-copy-locale="ko">홈</span>
              <span data-copy-locale="en">Home</span>
            </a>
            <a href="/manifesto">
              <span data-copy-locale="ko">선언문</span>
              <span data-copy-locale="en">Manifesto</span>
            </a>
          </nav>

          <div class="locale-switch" role="group" aria-label="Language switch">
            <button type="button" data-site-locale-btn data-locale="ko">한국어</button>
            <button type="button" data-site-locale-btn data-locale="en">English</button>
          </div>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>서울 실록 Seoul Sillok</p>
      <small>&copy; {new Date().getFullYear()} All rights reserved.</small>
    </footer>
    <script is:inline>
      (() => {
        const storageKey = 'seoul-sillok-locale';
        const root = document.documentElement;
        const buttons = Array.from(document.querySelectorAll('[data-site-locale-btn]'));

        const normalizeLocale = (value) => (value === 'en' ? 'en' : 'ko');

        const applyLocale = (value, persist) => {
          const locale = normalizeLocale(value);
          root.dataset.siteLocale = locale;
          root.lang = locale;

          buttons.forEach((button) => {
            const isActive = button.dataset.locale === locale;
            button.classList.toggle('active', isActive);
            button.setAttribute('aria-pressed', String(isActive));
          });

          if (persist) {
            try {
              localStorage.setItem(storageKey, locale);
            } catch {}
          }

          window.dispatchEvent(new CustomEvent('site-locale-change', { detail: { locale } }));
        };

        buttons.forEach((button) => {
          button.addEventListener('click', () => applyLocale(button.dataset.locale || 'ko', true));
        });

        applyLocale(root.dataset.siteLocale || 'ko', false);
      })();
    </script>
  </body>
</html>

<style>
  :global([data-copy-locale='en']) {
    display: none !important;
  }

  :global(html[data-site-locale='en'] [data-copy-locale='ko']) {
    display: none !important;
  }

  :global(html[data-site-locale='en'] [data-copy-locale='en']) {
    display: revert !important;
  }

  :global(html[data-site-locale='ko'] [data-copy-locale='ko']) {
    display: revert !important;
  }

  :root {
    --bg: #f4f1ea;
    --surface: #fffdf9;
    --text: #1f1c18;
    --muted: #645c50;
    --line: #ded8cb;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background:
      radial-gradient(circle at 10% 0%, #e9e4d8 0%, transparent 32%),
      radial-gradient(circle at 95% 8%, #ece8de 0%, transparent 28%),
      var(--bg);
    color: var(--text);
    font-family: 'Noto Sans KR', sans-serif;
  }

  header {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(8px);
    background: rgba(244, 241, 234, 0.88);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0.85rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .logo {
    color: var(--text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: 'Fraunces', serif;
    font-size: 1.1rem;
  }

  .logo-mark {
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    border: 1px solid #bfb7a7;
    display: grid;
    place-items: center;
    font-size: 0.74rem;
    color: #5f5648;
    background: #faf8f2;
    font-family: 'Noto Sans KR', sans-serif;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  nav a:hover {
    color: var(--text);
  }

  .locale-switch {
    display: inline-flex;
    gap: 0.2rem;
    padding: 0.2rem;
    border: 1px solid #d8d0c1;
    border-radius: 999px;
    background: rgba(255, 252, 246, 0.94);
  }

  .locale-switch button {
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    padding: 0.38rem 0.68rem;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .locale-switch button:hover,
  .locale-switch button:focus-visible {
    background: rgba(31, 29, 25, 0.08);
    color: var(--text);
    outline: none;
  }

  .locale-switch button.active {
    background: #1f1d19;
    color: #faf8f2;
  }

  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: 2rem 1rem 3.2rem;
  }

  footer {
    border-top: 1px solid var(--line);
    padding: 1.4rem 1rem 1.8rem;
    text-align: center;
    color: var(--muted);
    background: rgba(250, 248, 242, 0.8);
  }

  footer p {
    margin: 0;
    font-family: 'Fraunces', serif;
    letter-spacing: 0.03em;
  }

  footer small {
    display: block;
    margin-top: 0.28rem;
  }

  @media (max-width: 760px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .header-actions {
      width: 100%;
      justify-content: space-between;
    }

    main {
      padding-top: 1.6rem;
    }
  }
</style>
